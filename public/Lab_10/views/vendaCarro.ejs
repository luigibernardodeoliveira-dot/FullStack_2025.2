<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('layout', { body: `
  <section>
    <h2>Venda de carro</h2>
    <p><strong>Marca:</strong> ${carro.marca}</p>
    <p><strong>Modelo:</strong> ${carro.modelo}</p>
    <p><strong>Ano:</strong> ${carro.ano}</p>
    <p><strong>Preço:</strong> R$ ${carro.preco.toFixed(2)}</p>

    <form action="/carros/venda/${carro._id}" method="POST" class="form-grid">
      <label>Valor da venda (R$)
        <input type="number" step="0.01" name="valor" required value="${carro.preco}" />
      </label>
      <button type="submit" class="btn">Confirmar venda</button>
    </form>
  </section>
` }) %>

</body>
</html>