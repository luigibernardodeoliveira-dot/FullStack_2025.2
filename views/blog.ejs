<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Blog</title>
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <div class="container">
    <h1>Blog Online</h1>
    <a href="/cadastrar_post" class="btn">+ Novo Post</a>

    <% if (posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <div class="post">
          <h2><%= post.titulo %></h2>
          <p><strong><%= post.resumo %></strong></p>
          <p><%= post.conteudo %></p>
        </div>
      <% }) %>
    <% } else { %>
      <p>Nenhum post cadastrado ainda.</p>
    <% } %>
  </div>
</body>
</html>
