<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Blog</title>
  <link rel="stylesheet" href="/Lab_9/style.css">
</head>
<body>
  <div class="container">
    <h1>Postagens</h1>
    <a href="/"><button>Novo Post</button></a>
    <hr>

    <% if (posts.length === 0) { %>
      <p>Nenhum post encontrado </p>
    <% } else { %>
      <% posts.forEach(post => { %>
        <div class="post">
          <h2><%= post.titulo %></h2>

          <% if (post.resumo && post.resumo.trim() !== "") { %>
            <p class="resumo"><%= post.resumo %></p>
          <% } %>

          <p><%= post.conteudo %></p>
        </div>
      <% }) %>
    <% } %>
  </div>
</body>
</html>
