<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Blog</title>
  <link rel="stylesheet" href="../lab_9/style.css">
</head>
<body>
  <h1>Postagens</h1>
  <a href="/"><button>Novo Post</button></a>
  <hr>

  <% if (posts.length === 0) { %>
    <p>Nenhum post encontrado </p>
  <% } else { %>
    <% posts.forEach(post => { %>
      <div class="post">
        <h2><%= post.titulo %></h2>
        <p><%= post.conteudo %></p>
        <small><%= new Date(post.data).toLocaleString() %></small>
        <hr>
      </div>
    <% }) %>
  <% } %>
</body>
</html>
